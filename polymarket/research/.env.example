# POLYGON_RPC=

# --- News-Agent Calibration Observatory -------------------------------------
# Names only — put the real values in the git-ignored .env next to this file.
# newsagent/config.py:load_env() reads them at import; the shell environment
# always wins over the file.
# GUARDIAN_API_KEY=              # Guardian Open Platform (else the 'test' demo key)
# ANTHROPIC_API_KEY=             # Stage-A extraction / priors via API
# GEMINI_API_KEY=                # Gemini 2.5 Flash extraction provider flag
# GOOGLE_APPLICATION_CREDENTIALS= # GDELT BigQuery service-account JSON path
# OPENBB_FRED_API_KEY=           # data channel, offline ingest only
# OPENBB_BLS_API_KEY=            # data channel, offline ingest only (optional)
