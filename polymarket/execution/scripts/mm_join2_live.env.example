# Join-2 LOCAL live-run env — the operator's 1-contract measurement loop (NOT the VPS).
#
# Copy the lines you need into your shell (or `set -a; source ...; set +a`) ON TOP of the
# existing polymarket/execution/.env (which keeps the secrets: private key, api key/secret,
# passphrase, funder — never duplicated here). Every value below is non-secret.
#
# See maker/MM_JOIN2_RUNBOOK.md for the full pre-flight checklist and run order.

# --- the venue: fake = DRY-RUN rehearsal; real = the operator's live step -------------
POLYMARKET_VENUE=fake                       # flip to `real` ONLY at the runbook's live step

# --- market selection (from the 5-screen script; see the runbook §2) ------------------
# PYTHONPATH=. uv run python scripts/mm_join2_market_screen.py --emit-env 1   (research/)
POLYMARKET_MAKER_CONDITION_ID=              # <- paste the selected condition id
# POLYMARKET_MM_BRIDGE_ASSET_ID=            # optional; resolved from Gamma when unset

# --- 1-contract sizing + quoting ------------------------------------------------------
MAKER_SIZE_CONTRACTS=1
POLYMARKET_MM_BRIDGE_HALF_SPREAD=0.01
POLYMARKET_MM_BRIDGE_TICK=0.001
POLYMARKET_MAKER_ORDER_TYPE=GTC

# --- the safety harness (never weaken) -------------------------------------------------
POLYMARKET_MAX_REAL_ORDERS=1                # raise deliberately, run by run, never in code
POLYMARKET_REQUIRE_OPERATOR_CONFIRM=true    # per-order stdin confirm
POLYMARKET_MM_BRIDGE_MAX_INVENTORY=5        # HARD contracts cap: clip sizes are clamped to
                                            # the remaining band, so even a FULL fill stops
                                            # exactly at ±cap (worst case = cap, not cap+clip)

# --- Join-2c live-loop hygiene ---------------------------------------------------------
# Venue-state reconcile every N market events. Politics NegRisk books tick slowly
# (seconds-to-minutes between events), so 100 events ≈ several minutes between the
# read-only open-orders GETs — far inside CLOB rate limits.
POLYMARKET_MM_BRIDGE_RECONCILE_EVERY=100

# --- 2b measured latency (fill in AFTER the latency harness run; runbook §3) ----------
# The trimmed-mean constant from `--mode mm_latency` (its stdout prints this exact line).
POLYMARKET_MM_BRIDGE_LATENCY_MS=0

# --- latency harness knobs (runbook §3) -------------------------------------------------
POLYMARKET_MM_LATENCY_SAMPLES=200           # spec: K ≈ 200–500 per category
POLYMARKET_MM_LATENCY_CADENCE_S=30          # spec: 30–60s between probes
# POLYMARKET_MM_LATENCY_SIDE=auto           # auto | buy | sell
